{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet --version)",
      "Bash(dotnet ef migrations list *)",
      "Bash(dotnet ef migrations script *)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(npx ng build *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(dotnet ef migrations add *)",
      "Bash(dotnet ef migrations remove *)",
      "Bash(dotnet ef database *)",
      "Bash(dotnet add *)",
      "Bash(dotnet tool *)",
      "Bash(npm install *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/appsettings.Production.json)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(docker compose down -v *)",
      "Bash(sqllocaldb delete *)"
    ]
  }
}
